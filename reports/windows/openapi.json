  "components": {
    "schemas": {
      "Complaint": {
        "properties": {
          "city_id": {
            "type": "string",
            "title": "City Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "waterlogging",
              "road",
              "drainage",
              "water",
              "air_quality",
              "traffic",
              "infrastructure",
              "other"
            ],
            "title": "Category"
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Location"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 8,
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "city_id",
          "category",
          "location",
          "description"
        ],
        "title": "Complaint"
      },
      "ComplaintReview": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "under_review",
              "in_progress",
              "closed"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "ComplaintReview"
      },
      "Flood": {
        "properties": {
          "rain_mm": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Rain Mm",
            "default": 60
          },
          "duration_h": {
            "type": "number",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Duration H",
            "default": 6
          },
          "area_m2": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 10000.0,
            "title": "Area M2",
            "default": 50000
          },
          "runoff_coefficient": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.3,
            "title": "Runoff Coefficient",
            "default": 0.7
          },
          "drain_mm_h": {
            "type": "number",
            "maximum": 8.0,
            "minimum": 0.2,
            "title": "Drain Mm H",
            "default": 3
          },
          "blockage": {
            "type": "number",
            "maximum": 0.9,
            "minimum": 0.0,
            "title": "Blockage",
            "default": 0.5
          },
          "ponding_fraction": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.03,
            "title": "Ponding Fraction",
            "default": 0.1
          },
          "initial_storage_mm": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Initial Storage Mm",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Flood"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Resources": {
        "properties": {
          "budget": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Budget",
            "default": 50000
          },
          "pumps": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Pumps",
            "default": 4
          },
          "crew_hours": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Crew Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Resources"
      },
      "Review": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "pending",
              "defer",
              "reject",
              "approve"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "note"
        ],
        "title": "Review"
      },
      "Scenario": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Name",
            "default": "Monsoon stress test"
          },
          "city_id": {
            "type": "string",
            "title": "City Id",
            "default": "delhi"
          },
          "flood_engine": {
            "type": "string",
            "enum": [
              "mass_balance",
              "trained_surrogate"
            ],
            "title": "Flood Engine",
            "default": "mass_balance"
          },
          "flood": {
            "$ref": "#/components/schemas/Flood"
          },
          "initial": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Initial"
          },
          "load": {
            "type": "number",
            "maximum": 1.5,
            "minimum": 0.5,
            "title": "Load",
            "default": 1.1
          },
          "resources": {
            "$ref": "#/components/schemas/Resources"
          },
          "weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Scenario"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "verifier": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Verifier"
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Evidence Ref"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "completion_time": {
            "type": "string",
            "format": "date-time",
            "title": "Completion Time"
          },
          "verification_time": {
            "type": "string",
            "format": "date-time",
