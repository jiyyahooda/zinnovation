# Relative paths resolve from the project root. No macOS or drive-specific paths.
CIVICFLUX_DB=var/civicflux.sqlite3
CIVICFLUX_ADMIN_ID=ADMIN001
CIVICFLUX_ADMIN_PASSWORD=001
# Optional verified HTTP JSON source endpoints; unconfigured feeds abstain.
CIVICFLUX_IMD_URL=
CIVICFLUX_CPCB_URL=

# Optional server-side credentials. Weather/CAMS work without a key for noncommercial evaluation.
CIVICFLUX_DATA_GOV_KEY=
CIVICFLUX_TOMTOM_KEY=
